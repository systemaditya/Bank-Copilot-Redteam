# Copy to .env and adjust. Every COPILOT_ setting is optional.

# SQLite file by default. For PostgreSQL (needs `pip install -e ".[postgres]"`):
#   COPILOT_DATABASE_URL=postgresql://copilot:<password>@localhost:5432/bank
COPILOT_DATABASE_URL=sqlite:///./bank.db

# Only used by docker-compose.yml, which won't start without it. Pick your own; stick to
# letters and digits so it can sit inside a database URL without escaping.
POSTGRES_PASSWORD=

COPILOT_OLLAMA_URL=http://localhost:11434
# Any Ollama chat model that supports tool calling.
COPILOT_MODEL=llama3.2:3b
COPILOT_TEMPERATURE=0.0
COPILOT_MAX_TOOL_ROUNDS=5
COPILOT_RETURN_TRACE=true

# Policy search: "ollama" uses the embedding model below, "hashing" needs no model.
COPILOT_EMBEDDING_BACKEND=ollama
COPILOT_EMBEDDING_MODEL=nomic-embed-text
COPILOT_RAG_TOP_K=3

COPILOT_AUDIT_ENABLED=true
COPILOT_AUDIT_LOG_PATH=logs/audit.jsonl
